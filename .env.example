# Copy to .env and fill in. Never commit .env.

# Gemini API key (intent classification) - https://aistudio.google.com/apikey
API_KEY=

# Signing key for device tokens. Leave unset to auto-generate and persist to data/.secret.
# ARC_SECRET_KEY=

# Network. Loopback by default; use `tailscale serve` for HTTPS access from your phone.
# ARC_HOST=127.0.0.1
# ARC_PORT=8000
# URL the phone should use (printed in the pairing QR), e.g. your Tailscale MagicDNS name.
# ARC_PUBLIC_URL=https://my-mac.tailnet-name.ts.net
# Extra browser origins allowed by CORS (comma separated).
# ARC_CORS_ORIGINS=

# Limits
# ARC_MAX_JOBS=8
# ARC_MAX_JOBS_PER_DEVICE=3
# ARC_JOB_TIMEOUT=600
# ARC_MAX_PAIR_FAILURES=5
# ARC_PAIR_LOCKOUT_SECONDS=900
